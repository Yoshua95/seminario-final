# Public values from the same Supabase project used by apps/mobile.
# Copy to .env.local locally. Do not commit .env.local or service_role keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key

# /demo runs only in local development or Vercel Preview and never connects to Supabase.
# Production always blocks /demo. Preview uses ephemeral /tmp storage.
# FOURPACK_DEMO_DIRECTORY is an optional absolute path for isolated test storage.
