export const argentinaProvinces: string[];
export type ChinaMeasurements={packages:number;weight_kg:number;length_cm?:number;width_cm?:number;height_cm?:number;estimated?:boolean;volume_m3?:number};
export type ChinaLocation={province:string;city:string;district?:string;address?:string;delivery_mode?:'pickup'|'home'};
export type SenderType='agent'|'private_supplier'|'store'|'other';
export type ChinaPlan={version?:2;sender_type?:SenderType;sender_name?:string;kind:'agent'|'supplier';handoff:'agent_sends'|'supplier_sends'|'pickup';agent_name?:string;package_reference?:string;origin:ChinaLocation;destination:ChinaLocation;measurements:ChinaMeasurements};
export type ChinaWarehouse={id:string;operator_id?:string;alias:string;recipient:string;phone:string;province:string;city:string;district:string;postal_code:string;address_zh:string;instructions:string;active:boolean;is_default:boolean};
