export type DestinationSummary={agreed_mode:'pickup'|'home';import_fee:number;delivery_fee:number;total:number;currency:'ARS';acceptance_required:boolean;condition:string;pickup_summary?:{alias:string;province:string;city:string}};
export type DestinationAgreement=DestinationSummary&{pickup_snapshot:ArgentinaDepot;delivery_address:ChinaLocation|null};
export function positiveDeclared(value:string|number,decimals?:number):number;
export function senderLabel(sender?:SenderType):string;
