{
  "name": "4pack-platform",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@4pack/web",
    "dev:mobile": "npm run start --workspace=@4pack/mobile",
    "build:web": "npm run build --workspace=@4pack/web",
    "build:mobile": "npm run export:android --workspace=@4pack/mobile",
    "test": "npm run test:domain",
    "test:domain": "tsc -p tests/tsconfig.json && node --test tests/domain.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
